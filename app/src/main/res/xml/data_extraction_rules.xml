<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and higher. The same rule as backup_rules.xml, for the cloud backup and for a
    phone-to-phone transfer: the alarms and the history go, preferences stay behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
